# ---------------------------------------------------------------------------
# natrium (Xiaomi Mi 5s Plus / MSM8996Pro) mainline 6.18 内核配置片段
# 基线: arch/arm64/configs/defconfig (6.18 已含 90% 所需符号)
# 本文件只补 defconfig 缺失/需要强制的部分。用 scripts/kconfig/merge_config.sh 合入。
# ---------------------------------------------------------------------------

# --- 标识 ---
CONFIG_LOCALVERSION="-natrium"
CONFIG_DEFAULT_HOSTNAME="natrium"

# --- 显示: MSM DRM + JDI FHD R63452 面板 + fbdev console(无串口时靠屏幕看 log) ---
# 注意: DRM_MSM 的 Kconfig 有 `depends on QCOM_LLCC || QCOM_LLCC=n` 等限制，
#       若这些依赖是 =m，DRM_MSM 只能被降级成 m；要让图形栈内建就必须把它们一起设成 y。
CONFIG_DRM=y
CONFIG_DRM_KMS_HELPER=y
CONFIG_DRM_MIPI_DSI=y
CONFIG_DRM_MSM=y
CONFIG_DRM_MSM_DSI=y
CONFIG_DRM_MSM_DSI_20NM_PHY=y
CONFIG_DRM_MSM_GPU_STATE=y
CONFIG_DRM_MSM_GPU_SUDO=y
CONFIG_DRM_PANEL_JDI_R63452=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE_DETECT_PRIMARY=y
CONFIG_FRAMEBUFFER_CONSOLE_ROTATION=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_BACKLIGHT_QCOM_WLED=y
CONFIG_DRM_PANEL=y
CONFIG_DRM_BRIDGE=y
CONFIG_QCOM_LLCC=y
CONFIG_QCOM_COMMAND_DB=y
CONFIG_QCOM_AOSS_QMP=y
# MSM8996(a5xx) 不使用 OCMEM；defconfig 里它是 =m，会把 DRM_MSM 一起拖成 m
# CONFIG_QCOM_OCMEM is not set

# --- 触摸: Synaptics RMI4 @ blsp2_i2c6 ---
CONFIG_INPUT=y
CONFIG_INPUT_TOUCHSCREEN=y
CONFIG_RMI4_CORE=y
CONFIG_RMI4_I2C=y
CONFIG_RMI4_SPI=y
CONFIG_RMI4_SMB=y
CONFIG_RMI4_F03=y
CONFIG_RMI4_F11=y
CONFIG_RMI4_F12=y
CONFIG_RMI4_F30=y
CONFIG_RMI4_F34=y
CONFIG_RMI4_F54=y
CONFIG_RMI4_F55=y

# --- 存储: UFS (userdata/system 所在) + SD ---
# 注意: 6.18 主线里 msm8996 的 UFS PHY 由 QMP UFS PHY 驱动负责
#       (旧名 PHY_QCOM_UFS_20NM 已不存在)，defconfig 里它是 =m，
#       而 initramfs 阶段无法加载模块 —— 必须是 =y，否则 UFS 起不来。
CONFIG_SCSI_UFS_QCOM=y
CONFIG_PHY_QCOM_QMP=y
CONFIG_PHY_QCOM_QMP_UFS=y
CONFIG_PHY_QCOM_UFS=y
CONFIG_MMC=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_PLTFM=y
CONFIG_MMC_SDHCI_MSM=y
CONFIG_F2FS_FS=y
CONFIG_F2FS_FS_XATTR=y
CONFIG_F2FS_FS_POSIX_ACL=y

# --- USB: dwc3 + gadget(configfs/adb) ---
CONFIG_USB=y
CONFIG_USB_SUPPORT=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_QCOM=y
CONFIG_USB_DWC3_DUAL_ROLE=y
CONFIG_PHY_QCOM_QUSB2=y
CONFIG_USB_GADGET=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_SERIAL=y
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_USB_CONFIGFS_F_FS=y
CONFIG_USB_CONFIGFS_RNDIS=y
CONFIG_USB_CONFIGFS_ECM=y

# --- 电源 / PMIC (PM8994 + PMI8994) ---
CONFIG_MFD_SPMI_PMIC=y
CONFIG_REGULATOR_QCOM_SPMI=y
CONFIG_PINCTRL_QCOM_SPMI_PMIC=y
CONFIG_QCOM_SPMI_ADC5=y
CONFIG_QCOM_SPMI_TEMP_ALARM=y
CONFIG_INPUT_PM8XXX_VIBRATOR=y
CONFIG_INPUT_PM8941_PWRKEY=y
CONFIG_CHARGER_QCOM_SMBB=y
CONFIG_BATTERY_PM8916_BMS_VM=y
CONFIG_THERMAL=y
CONFIG_QCOM_TSENS=y
CONFIG_THERMAL_GOV_STEP_WISE=y

# --- 时钟 / 互连 / 电源域 ---
CONFIG_QCOM_CLK_SMD_RPM=y
CONFIG_QCOM_SMD_RPM=y
CONFIG_QCOM_RPMH=y
CONFIG_QCOM_GDSC=y
CONFIG_QCOM_RPMPD=y
CONFIG_MSM_GCC_8996=y
CONFIG_QCOM_HFPLL=y
CONFIG_QCOM_CLK_APCC_MSM8996=y
CONFIG_INTERCONNECT_QCOM=y
CONFIG_INTERCONNECT_QCOM_MSM8996=y

# --- remoteproc: adsp / mss(modem) / slpi / venus ---
CONFIG_QCOM_Q6V5_PAS=y
CONFIG_QCOM_Q6V5_MSS=y
CONFIG_QCOM_Q6V5_WCSS=y
CONFIG_QCOM_SYSMON=y
CONFIG_QCOM_WCNSS_PIL=y
CONFIG_QCOM_WCNSS_CTRL=y
CONFIG_QCOM_SMD=y
CONFIG_QCOM_SMEM=y
CONFIG_QCOM_SMSM=y
CONFIG_RPMSG_QCOM_GLINK_SMEM=y
CONFIG_RPMSG_QCOM_SMD=y
CONFIG_QCOM_GSBI=y
CONFIG_QCOM_IPA=y

# --- WiFi / BT: wcn36xx (QCA6174 via WCNSS) ---
CONFIG_WLAN=y
CONFIG_WLAN_VENDOR_ATH=y
CONFIG_ATH_COMMON=y
CONFIG_WCN36XX=y
CONFIG_WCN36XX_DEBUGFS=y
CONFIG_MAC80211=y
CONFIG_CFG80211=y
CONFIG_BT=y
CONFIG_BT_HCIUART=y
CONFIG_BT_QCOMSMD=y
CONFIG_RFKILL=y

# --- 音频: apq8096 sndcard + WCD9335 ---
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_SOC=y
CONFIG_SND_SOC_MSM8996=y
CONFIG_SND_SOC_WCD9335=y
CONFIG_SND_SOC_QDSP6=y
CONFIG_SND_SOC_QDSP6_APM=y
CONFIG_SND_SOC_QDSP6_COMMON=y
CONFIG_SND_SOC_QDSP6_Q6VOICE=y
CONFIG_QCOM_APR=y
CONFIG_SLIMBUS=y
CONFIG_SLIM_QCOM_CTRL=y
CONFIG_SLIM_QCOM_NGD_CTRL=y

# --- 按键 / 传感器 I2C ---
CONFIG_I2C=y
CONFIG_I2C_QCOM_GENI=y
CONFIG_SPI=y
CONFIG_SPI_QUP=y
CONFIG_INPUT_MISC=y
CONFIG_INPUT_UINPUT=y

# --- 文件系统 / initramfs / 调试 ---
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_RD_XZ=y
CONFIG_RD_LZ4=y
CONFIG_RD_ZSTD=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_SERIAL_MSM=y
CONFIG_SERIAL_MSM_CONSOLE=y
CONFIG_SERIAL_QCOM_GENI=y
CONFIG_SERIAL_QCOM_GENI_CONSOLE=y
CONFIG_ARM_QCOM_CPUFREQ_NVMEM=y
CONFIG_ARM_QCOM_CPUFREQ_HW=y
CONFIG_CPU_FREQ_GOV_SCHEDUTIL=y
CONFIG_CPUFREQ_DT=y
CONFIG_DEBUG_FS=y
CONFIG_MAGIC_SYSRQ=y
CONFIG_PRINTK_TIME=y
CONFIG_PANIC_TIMEOUT=10
CONFIG_PSTORE=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_RAM=y
CONFIG_ANDROID_BINDER_IPC=y
CONFIG_ANDROID_BINDERFS=y

# --- 构建速度: 不生成 BTF/调试信息(首次点亮不需要, 省一半时间) ---
# CONFIG_DEBUG_INFO is not set
# CONFIG_DEBUG_INFO_BTF is not set
# CONFIG_DEBUG_INFO_DWARF5 is not set
